<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.app.controller.AiChatController"
      spacing="10" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="🤖 Qwen AI Assistant" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #6f42c1;"/>
        <Label fx:id="modelStatusLabel" text="● Loading..." style="-fx-font-size: 12; -fx-text-fill: #ffc107;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="clearChatBtn" text="🗑️ Clear Chat" onAction="#handleClearChat"
                style="-fx-base: #6c757d; -fx-text-fill: white;"/>
        <Button fx:id="exportChatBtn" text="💾 Export Chat" onAction="#handleExportChat"
                style="-fx-base: #28a745; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <!-- Chat Messages Area -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 8;">
        <VBox fx:id="chatContainer" spacing="8"/>
    </ScrollPane>

    <!-- Input Area -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextArea fx:id="chatInput" prefHeight="60" wrapText="true" HBox.hgrow="ALWAYS"
                  style="-fx-font-size: 13; -fx-border-color: #ced4da; -fx-border-radius: 4; -fx-background-radius: 4;"/>
        <Button fx:id="sendChatBtn" text="Send" onAction="#handleSendChatMessage"
                style="-fx-base: #6f42c1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
    </HBox>

    <!-- Quick Action Buttons -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="⚡ Quick Actions:" style="-fx-font-weight: bold; -fx-font-size: 11; -fx-text-fill: #495057;"/>
        <Button text="Fix Geographic Errors" onAction="#handleQuickFixGeo"
                style="-fx-base: #28a745; -fx-text-fill: white; -fx-font-size: 11; -fx-padding: 5 12 5 12;"/>
        <Button text="Validate All Data" onAction="#handleQuickValidate"
                style="-fx-base: #17a2b8; -fx-text-fill: white; -fx-font-size: 11; -fx-padding: 5 12 5 12;"/>
        <Button text="Summarize Data" onAction="#handleQuickSummarize"
                style="-fx-base: #fd7e14; -fx-text-fill: white; -fx-font-size: 11; -fx-padding: 5 12 5 12;"/>
        <Button text="Find Anomalies" onAction="#handleQuickAnomalies"
                style="-fx-base: #dc3545; -fx-text-fill: white; -fx-font-size: 11; -fx-padding: 5 12 5 12;"/>
    </HBox>

    <!-- Status Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
        <ProgressBar fx:id="aiProgressBar" prefWidth="200" visible="false" style="-fx-accent: #6f42c1;"/>
        <Label fx:id="aiStatusLabel" text="Ready" style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="tokenCountLabel" text="Tokens: 0" style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
    </HBox>
</VBox>