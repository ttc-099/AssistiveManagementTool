<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.app.controller.MainController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- ===== TOOLBAR ===== -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="📂 Open File" onAction="#handleOpenFile" style="-fx-font-weight: bold;"/>
        <Label fx:id="filePathLabel" text="No file selected" style="-fx-text-fill: #6c757d;"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="reviewErrorsBtn" text="⚠️ Review Data Errors" onAction="#handleReviewErrors"
                visible="false" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <!-- ===== MAIN TAB PANE WITH FX:INCLUDE ===== -->
    <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- Table Tab -->
        <Tab text="Table">
            <fx:include fx:id="dataView" source="DataView.fxml"/>
        </Tab>

        <!-- Pivot & Charts Tab -->
        <Tab text="Pivot and Charts">
            <fx:include fx:id="chartView" source="ChartView.fxml"/>
        </Tab>

        <!-- AI Review Tab -->
        <Tab text="AI Review">
            <fx:include fx:id="aiChatView" source="AiChatView.fxml"/>
        </Tab>

        <!-- Dashboard Tab -->
        <Tab text="Dashboard">
            <fx:include fx:id="dashboardView" source="DashboardView.fxml"/>
        </Tab>

        <!-- Additional Tools Tab -->
        <Tab text="Additional Tools">
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-border-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <Label text="🛠️ Additional Tools" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                    <Separator/>

                    <!-- ============================================================ -->
                    <!-- SECTION 1: DATA ENRICHMENT TOOLS                              -->
                    <!-- ============================================================ -->
                    <Label text="📌 Data Enrichment" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #17a2b8; -fx-padding: 10 0 5 0;"/>
                    <Separator style="-fx-padding: 0 0 5 0;"/>

                    <!-- Region Mass Adder -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📍" style="-fx-font-size: 32;"/>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Region Mass Adder" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
                                <Label text="Add a 'Region' column to multiple Excel files at once." style="-fx-font-size: 12; -fx-text-fill: #6c757d;" wrapText="true"/>
                            </VBox>
                            <Button text="Open Tool" onAction="#handleRegionMassAdder"
                                    style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
                        </HBox>
                    </VBox>

                    <!-- ============================================================ -->
                    <!-- SECTION 2: ANALYSIS & REPORTING TOOLS                         -->
                    <!-- ============================================================ -->
                    <Label text="📊 Analysis and Reporting" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #28a745; -fx-padding: 10 0 5 0;"/>
                    <Separator style="-fx-padding: 0 0 5 0;"/>

                    <!-- Region Analyser -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📊" style="-fx-font-size: 32;"/>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="2025/2026 Region Analyser" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
                                <Label text="Analyse and compare regional data across 2025 and 2026." style="-fx-font-size: 12; -fx-text-fill: #6c757d;" wrapText="true"/>
                            </VBox>
                            <Button text="Open Tool" onAction="#handleRegionAnalyser"
                                    style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
                        </HBox>
                    </VBox>

                    <!-- Country Analyser -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="🌍" style="-fx-font-size: 32;"/>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Country Analyser" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
                                <Label text="Analyse country distributions in 'FY data' and 'UGPG data' sheets." style="-fx-font-size: 12; -fx-text-fill: #6c757d;" wrapText="true"/>
                            </VBox>
                            <Button text="Open Tool" onAction="#handleCountryAnalyser"
                                    style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
                        </HBox>
                    </VBox>

                    <!-- ============================================================ -->
                    <!-- SECTION 3: LIST MANAGEMENT TOOLS                              -->
                    <!-- ============================================================ -->
                    <Label text="📋 List Management" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #fd7e14; -fx-padding: 10 0 5 0;"/>
                    <Separator style="-fx-padding: 0 0 5 0;"/>

                    <!-- UA List Updater -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📋" style="-fx-font-size: 32;"/>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="UA List Updater" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
                                <Label text="Update the UA list from the main database." style="-fx-font-size: 12; -fx-text-fill: #6c757d;" wrapText="true"/>
                            </VBox>
                            <Button text="Open Tool" onAction="#handleUAListUpdater"
                                    style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
                        </HBox>
                    </VBox>

                    <!-- Invoice List Updater (Coming Soon) -->
                    <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📝" style="-fx-font-size: 32;"/>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Invoice List Updater" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #6c757d;"/>
                                    <Label text="🚧 Coming Soon" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #fd7e14; -fx-background-color: #fff3cd; -fx-padding: 2 8 2 8; -fx-background-radius: 4;"/>
                                </HBox>
                                <Label text="Manage and update invoice records efficiently." style="-fx-font-size: 12; -fx-text-fill: #6c757d;" wrapText="true"/>
                            </VBox>
                            <Button text="Open Tool" onAction="#handleInvoiceListUpdater"
                                    disable="true"
                                    style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>

    <!-- ===== BOTTOM STATUS BAR ===== -->
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
        <Label fx:id="bottomRowCountLabel" text="0 rows loaded" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
        <Label fx:id="bottomColCountLabel" text="0 columns" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📤 Export to PowerPoint" onAction="#handleExport"
                style="-fx-background-color: #003366; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>