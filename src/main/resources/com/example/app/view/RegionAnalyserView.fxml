<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.app.controller.RegionAnalyserController"
      fx:id="mainContainer"
      style="-fx-background-color: #f0f4f8; -fx-padding: 15;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 15 0;">
        <Label text="📊 2025/2026 Region Analyser" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #003366;">
            <font>
                <Font name="Arial" size="20"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✕" onAction="#handleClose" style="-fx-base: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
    </HBox>

    <!-- File Load Section -->
    <HBox spacing="20" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5;">
        <!-- 2025 File -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="📁 2025 Data" style="-fx-font-weight: bold; -fx-text-fill: #003366;"/>
            <HBox spacing="10">
                <Button fx:id="load2025Btn" text="Load 2025 File" onAction="#handleLoad2025"
                        style="-fx-base: #28a745; -fx-text-fill: white;"/>
                <Label fx:id="file2025Label" text="No file loaded" style="-fx-text-fill: #6c757d; -fx-font-style: italic;"/>
            </HBox>
        </VBox>

        <!-- 2026 File -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="📁 2026 Data" style="-fx-font-weight: bold; -fx-text-fill: #003366;"/>
            <HBox spacing="10">
                <Button fx:id="load2026Btn" text="Load 2026 File" onAction="#handleLoad2026"
                        style="-fx-base: #17a2b8; -fx-text-fill: white;"/>
                <Label fx:id="file2026Label" text="No file loaded" style="-fx-text-fill: #6c757d; -fx-font-style: italic;"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Action Buttons -->
    <HBox spacing="10" style="-fx-padding: 10 0 10 0;">
        <Button fx:id="generateBtn" text="🔄 Generate Report" onAction="#handleGenerate"
                disable="true" style="-fx-base: #003366; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20 8 20;"/>
        <Button fx:id="exportBtn" text="📤 Export to Excel" onAction="#handleExport"
                disable="true" style="-fx-base: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20 8 20;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="Load 2025 and 2026 Excel files to begin."
               style="-fx-text-fill: #6c757d; -fx-font-style: italic;"/>
    </HBox>

    <!-- Preview Table -->
    <VBox spacing="5" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-background-radius: 5;">
        <Label text="📋 Preview" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #003366;"/>
        <ScrollPane VBox.vgrow="ALWAYS" style="-fx-border-color: #dee2e6; -fx-border-radius: 3; -fx-background-color: white;">
            <TableView fx:id="previewTable" prefHeight="400">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Load and generate report to preview data"
                           style="-fx-font-size: 14px; -fx-text-fill: #6c757d;"/>
                </placeholder>
            </TableView>
        </ScrollPane>
    </VBox>

    <!-- Legend -->
    <HBox spacing="20" style="-fx-padding: 10 0 0 0;">
        <HBox spacing="5" alignment="CENTER">
            <Label text="■" style="-fx-text-fill: #0072B2; -fx-font-size: 16px;"/>
            <Label text="Foundation Programmes" style="-fx-font-size: 11px; -fx-text-fill: #6c757d;"/>
        </HBox>
        <HBox spacing="5" alignment="CENTER">
            <Label text="■" style="-fx-text-fill: #28A745; -fx-font-size: 16px;"/>
            <Label text="UG &amp; PG Programmes" style="-fx-font-size: 11px; -fx-text-fill: #6c757d;"/>
        </HBox>
        <HBox spacing="5" alignment="CENTER">
            <Label text="■" style="-fx-text-fill: #e9ecef; -fx-font-size: 16px; -fx-border-color: #6c757d; -fx-border-width: 1;"/>
            <Label text="Total Row" style="-fx-font-size: 11px; -fx-text-fill: #6c757d;"/>
        </HBox>
    </HBox>
</VBox>