<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.app.controller.RegionMassAdderController"
      style="-fx-background-color: #f0f4f8; -fx-padding: 20;">

    <!-- Header Section -->
    <VBox spacing="4" style="-fx-padding: 0 0 15 0;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Region Mass Adder" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #003366;">
                <font>
                    <Font name="System Bold" size="22"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#handleClose" style="-fx-base: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 15; -fx-min-width: 30; -fx-min-height: 30;"/>
        </HBox>
        <Label text="Automatically adds Region column to 'FY data' &amp; 'UGPG data' sheets and populates based on country mappings." style="-fx-font-size: 12px; -fx-text-fill: #5a6b82;"/>
    </VBox>

    <!-- Main Content Grid -->
    <HBox spacing="15" VBox.vgrow="ALWAYS">

        <!-- Left Panel: Step-by-Step Configuration -->
        <VBox spacing="12"
              minWidth="280"
              maxWidth="320"
              style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8;"
              HBox.hgrow="NEVER">

            <!-- Step 1: Select Files -->
            <VBox spacing="8">
                <Label text="STEP 1: Select Excel Files" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #003366; -fx-letter-spacing: 0.5px;"/>
                <HBox spacing="5">
                    <Button text="+ Add Files" onAction="#handleAddFiles" style="-fx-base: #28a745; -fx-text-fill: white; -fx-font-weight: bold;">
                        <font>
                            <Font name="Arial" size="11"/>
                        </font>
                    </Button>
                    <Button text="Remove" onAction="#handleRemoveSelectedFile" style="-fx-base: #dc3545; -fx-text-fill: white;">
                        <font>
                            <Font name="Arial" size="11"/>
                        </font>
                    </Button>
                    <Button text="Clear All" onAction="#handleClearFiles" style="-fx-base: #6c757d; -fx-text-fill: white;">
                        <font>
                            <Font name="Arial" size="11"/>
                        </font>
                    </Button>
                </HBox>

                <ListView fx:id="fileListView" prefHeight="150" prefWidth="250" style="-fx-border-color: #dee2e6; -fx-border-radius: 4;"/>

                <HBox spacing="10">
                    <Label fx:id="fileCountLabel" text="Files: 0" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="processedCountLabel" text="Processed: 0" style="-fx-text-fill: #28a745; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <Separator style="-fx-padding: 2 0;"/>

            <!-- Step 2: Configure & Process -->
            <VBox spacing="8">
                <Label text="STEP 2: Configure &amp; Process" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #003366;"/>

                <Label text="Country Column Target:" style="-fx-text-fill: #495057; -fx-font-size: 11px;"/>
                <ComboBox fx:id="countryColumnSelector" promptText="Select Country Column" prefWidth="280" style="-fx-background-color: #f8f9fa; -fx-border-color: #ced4da; -fx-border-radius: 4;"/>

                <Label text="⚠️ Region column will be automatically added and populated." style="-fx-text-fill: #856404; -fx-font-size: 10px; -fx-wrap-text: true; -fx-font-style: italic; -fx-background-color: #fff3cd; -fx-padding: 4 8; -fx-border-radius: 3; -fx-background-radius: 3;"/>

                <Button fx:id="processFilesBtn" text="▶ Process Selected File" onAction="#handleProcessFiles"
                        disable="true" prefWidth="280" style="-fx-base: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8;">
                    <font>
                        <Font name="Arial" size="12"/>
                    </font>
                </Button>
            </VBox>

            <!-- Validation Status -->
            <VBox spacing="4" style="-fx-background-color: #e9ecef; -fx-padding: 8; -fx-border-radius: 4; -fx-background-radius: 4;">
                <Label text="File Validation:" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #495057;"/>
                <Label fx:id="validationLabel" text="No file selected" style="-fx-font-size: 10px; -fx-text-fill: #6c757d; -fx-wrap-text: true;"/>
            </VBox>
        </VBox>

        <!-- Right Panel: Preview & Export -->
        <VBox spacing="10"
              style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8;"
              HBox.hgrow="ALWAYS">

            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <VBox spacing="2">
                    <Label text="STEP 3: Preview &amp; Export" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #003366;"/>
                    <Label fx:id="previewInfoLabel" text="Select and process a file to preview data" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Sheet Selector -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Sheet:" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #495057;"/>
                <ComboBox fx:id="sheetSelector" promptText="Select Sheet" style="-fx-background-color: #f8f9fa; -fx-border-color: #ced4da; -fx-border-radius: 4;"/>
                <Label fx:id="rowCountLabel" text="" style="-fx-font-size: 10px; -fx-text-fill: #6c757d; -fx-padding: 0 0 0 10;"/>
            </HBox>

            <!-- Preview Table -->
            <ScrollPane VBox.vgrow="ALWAYS"
                        style="-fx-border-color: #dee2e6; -fx-border-radius: 4; -fx-background-color: white;"
                        fitToWidth="false"
                        fitToHeight="true"
                        hbarPolicy="AS_NEEDED"
                        vbarPolicy="AS_NEEDED">
                <TableView fx:id="previewTable" prefHeight="380">
                    <!-- No resize policy set here - will be set in controller -->
                </TableView>
            </ScrollPane>

            <!-- Status Indicator -->
            <VBox style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-color: #e9ecef; -fx-border-radius: 5; -fx-background-radius: 5;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Status:" style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 11px;"/>
                    <Label fx:id="statusLabel" text="Waiting for Excel files to be added..." style="-fx-text-fill: #6c757d; -fx-wrap-text: true; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>

            <!-- Actions Bar -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="exportFilesBtn" text="📤 Export Modified Files" onAction="#handleExportFiles"
                        disable="true" style="-fx-base: #003366; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;">
                    <font>
                        <Font name="Arial Black" size="12"/>
                    </font>
                </Button>
            </HBox>
        </VBox>

    </HBox>
</VBox>