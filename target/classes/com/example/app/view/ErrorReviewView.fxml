<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.app.controller.ErrorReviewController"
      spacing="10" prefWidth="600" prefHeight="400">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Data Validation Errors Detected" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
    <Label text="Review the misaligned geographic entries below and accept suggestions to correct the data in memory." wrapText="true"/>

    <TableView fx:id="errorTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="headerCol" text="Header" prefWidth="100"/>
            <TableColumn fx:id="valueCol" text="Value Found" prefWidth="150"/>
            <TableColumn fx:id="suggestionCol" text="Did you mean?" prefWidth="250"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Ignore All" onAction="#handleCancel"/>
        <Button text="Accept All Selected Corrections" onAction="#handleAccept" style="-fx-base: #28a745; -fx-text-fill: white;"/>
    </HBox>
</VBox>
