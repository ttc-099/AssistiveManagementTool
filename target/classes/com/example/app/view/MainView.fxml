<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.app.controller.MainController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Open File" onAction="#handleOpenFile"/>
        <Label fx:id="filePathLabel" text="No file selected" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="reviewErrorsBtn" text="Review Data Errors" onAction="#handleReviewErrors"
                visible="false" style="-fx-base: #dc3545; -fx-text-fill: white;"/>
    </HBox>

    <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Table">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Select Columns:"/>
                    <CheckComboBox fx:id="columnSelector" prefWidth="200"/>
                    <Label text="Start Date:"/>
                    <DatePicker fx:id="startDatePicker"/>
                    <Label text="End Date:"/>
                    <DatePicker fx:id="endDatePicker"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Search:"/>
                    <TextField fx:id="searchField" promptText="Type to filter..." HBox.hgrow="ALWAYS"/>
                </HBox>
                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="true">
                    <TableView fx:id="dataTable" style="-fx-selection-bar: #cfe2f3; -fx-selection-bar-non-focused: #e8f0f7;"/>
                </ScrollPane>
            </VBox>
        </Tab>

        <Tab text="Pivot Table">
            <HBox spacing="0" VBox.vgrow="ALWAYS">
                <!-- Pivot Field List Sidebar -->
                <VBox spacing="10" prefWidth="280" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="PivotTable Fields" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <Button text="?" style="-fx-font-weight: bold; -fx-min-width: 20; -fx-max-width: 20; -fx-min-height: 20; -fx-max-height: 20; -fx-background-radius: 10;"
                                onAction="#handlePivotHelp"/>
                    </HBox>

                    <Label text="Choose fields to add to report:" style="-fx-font-size: 11; -fx-text-fill: #6c757d;"/>
                    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true">
                        <VBox fx:id="pivotFieldsContainer" spacing="5"/>
                    </ScrollPane>
                    <Separator/>
                    <Label text="Rows:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="pivotRowCombo" maxWidth="Infinity"/>
                    <Label text="Values:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="pivotValueCombo" maxWidth="Infinity"/>
                    <Label text="Summarize by:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="pivotAggCombo" maxWidth="Infinity"/>

                    <Separator/>
                    <HBox spacing="5">
                        <Button text="Update Pivot" onAction="#handleUpdateDashboard" maxWidth="Infinity"
                                style="-fx-base: #217346; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                        <Button text="Add to Dashboard" onAction="#handleAddPivotToDashboard" maxWidth="Infinity"
                                style="-fx-base: #007bff; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <TableView fx:id="pivotTable" VBox.vgrow="ALWAYS" style="-fx-selection-bar: #cfe2f3;">
                        <columns>
                            <TableColumn fx:id="pivotGroupCol" text="Row Labels" prefWidth="300"/>
                            <TableColumn fx:id="pivotValueCol" text="Values" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Bar Chart">
            <HBox spacing="0" VBox.vgrow="ALWAYS">
                <!-- Bar Chart Field Selector Sidebar -->
                <VBox spacing="10" prefWidth="280" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Bar Chart Fields" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <Button text="?" style="-fx-font-weight: bold; -fx-min-width: 20; -fx-max-width: 20; -fx-min-height: 20; -fx-max-height: 20; -fx-background-radius: 10;"
                                onAction="#handleBarChartHelp"/>
                    </HBox>

                    <Label text="Choose fields for the bar chart:" style="-fx-font-size: 11; -fx-text-fill: #6c757d;"/>

                    <Separator/>
                    <Label text="Categories (X-Axis):" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="barChartCategoryCombo" maxWidth="Infinity"/>

                    <Label text="Values (Y-Axis):" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="barChartValueCombo" maxWidth="Infinity"/>

                    <Label text="Aggregation:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="barChartAggCombo" maxWidth="Infinity"/>

                    <Label text="Group By (Optional):" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="barChartGroupCombo" maxWidth="Infinity"/>

                    <Separator/>
                    <HBox spacing="5">
                        <Button text="Update Chart" onAction="#handleUpdateBarChart" maxWidth="Infinity"
                                style="-fx-base: #28a745; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                        <Button text="Add to Dashboard" onAction="#handleAddBarChartToDashboard" maxWidth="Infinity"
                                style="-fx-base: #007bff; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button text="Clear Fields" onAction="#handleClearBarChart" maxWidth="Infinity"
                            style="-fx-base: #6c757d; -fx-text-fill: white;"/>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <BarChart fx:id="barChart" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis label="Category" /></xAxis>
                        <yAxis><NumberAxis label="Value" /></yAxis>
                    </BarChart>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Pie Chart">
            <HBox spacing="0" VBox.vgrow="ALWAYS">
                <!-- Pie Chart Field Selector Sidebar -->
                <VBox spacing="10" prefWidth="280" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Pie Chart Fields" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <Button text="?" style="-fx-font-weight: bold; -fx-min-width: 20; -fx-max-width: 20; -fx-min-height: 20; -fx-max-height: 20; -fx-background-radius: 10;"
                                onAction="#handlePieChartHelp"/>
                    </HBox>

                    <Label text="Choose fields for the pie chart:" style="-fx-font-size: 11; -fx-text-fill: #6c757d;"/>

                    <Separator/>
                    <Label text="Categories (Slices):" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="pieChartCategoryCombo" maxWidth="Infinity"/>

                    <Label text="Values:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="pieChartValueCombo" maxWidth="Infinity"/>

                    <Label text="Aggregation:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="pieChartAggCombo" maxWidth="Infinity"/>

                    <Separator/>
                    <HBox spacing="5">
                        <Button text="Update Chart" onAction="#handleUpdatePieChart" maxWidth="Infinity"
                                style="-fx-base: #dc3545; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                        <Button text="Add to Dashboard" onAction="#handleAddPieChartToDashboard" maxWidth="Infinity"
                                style="-fx-base: #007bff; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button text="Clear Fields" onAction="#handleClearPieChart" maxWidth="Infinity"
                            style="-fx-base: #6c757d; -fx-text-fill: white;"/>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <PieChart fx:id="pieChart" VBox.vgrow="ALWAYS" />
                </VBox>
            </HBox>
        </Tab>

        <!-- AI Review Tab -->
        <Tab text="AI Review">
            <VBox spacing="20">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="LLM Data Repair Service" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                </HBox>
                <Separator/>
                <VBox spacing="10" alignment="CENTER" VBox.vgrow="ALWAYS">
                    <Label text="Use the Llama-powered AI Agent to scan and auto-correct messy data rows."
                           style="-fx-font-size: 14; -fx-text-fill: #495057;"/>
                    <Button fx:id="aiReviewBtn" text="Start AI Data Review" onAction="#handleAIReview"
                            style="-fx-base: #6f42c1; -fx-text-fill: white; -fx-padding: 10 20 10 20; -fx-font-size: 14;"/>
                    <ProgressBar fx:id="aiProgressBar" prefWidth="400" visible="false"/>
                    <Label fx:id="aiStatusLabel" text="Ready" visible="false" style="-fx-text-fill: #6c757d;"/>
                </VBox>
                <Separator/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="aiAutoApplyCheck" text="Auto-apply high confidence corrections" selected="true"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- New Dashboard Tab -->
        <Tab text="Dashboard">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Dashboard" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Clear All" onAction="#handleClearDashboard" style="-fx-base: #dc3545; -fx-text-fill: white;"/>
                    <Button text="Export Dashboard" onAction="#handleExportDashboard" style="-fx-base: #28a745; -fx-text-fill: white;"/>
                </HBox>
                <Separator/>
                <ScrollPane fx:id="dashboardScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true">
                    <VBox fx:id="dashboardContainer" spacing="20" style="-fx-padding: 10;">
                        <Label text="No items added to dashboard yet. Use 'Add to Dashboard' buttons in the Pivot Table, Bar Chart, or Pie Chart tabs."
                               style="-fx-font-size: 14; -fx-text-fill: #6c757d; -fx-wrap-text: true;"/>
                    </VBox>
                </ScrollPane>
            </VBox>
        </Tab>

        <Tab text="Additional Tools">
            <VBox spacing="20" VBox.vgrow="ALWAYS">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Additional Tools" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Separator/>

                <!-- Region Mass Adder Tool Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="📍" style="-fx-font-size: 32;"/>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Region Mass Adder" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
                            <Label text="Add a 'Region' column to multiple Excel files at once. Detects the 'Country' column and inserts a blank Region column to its right."
                                   style="-fx-font-size: 12; -fx-text-fill: #6c757d; -fx-wrap-text: true;"/>
                        </VBox>
                        <Button text="Open Tool" onAction="#handleRegionMassAdder"
                                style="-fx-base: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;">
                            <tooltip>
                                <Tooltip text="Open Region Mass Adder tool"/>
                            </tooltip>
                        </Button>
                    </HBox>
                </VBox>

                <!-- 2025/2026 Region Analyser Tool Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="📊" style="-fx-font-size: 32;"/>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="2025/2026 Region Analyser" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
                            <Label text="Analyse and compare regional data across 2025 and 2026. Identify trends, growth patterns, and regional performance metrics."
                                   style="-fx-font-size: 12; -fx-text-fill: #6c757d; -fx-wrap-text: true;"/>
                        </VBox>
                        <Button text="Open Tool" onAction="#handleRegionAnalyser"
                                style="-fx-base: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;">
                            <tooltip>
                                <Tooltip text="Open 2025/2026 Region Analyser tool"/>
                            </tooltip>
                        </Button>
                    </HBox>
                </VBox>

                <!-- UA List Updater Tool Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="📋" style="-fx-font-size: 32;"/>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="UA List Updater" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
                            <Label text="Update the UA list from the main database. Find new UA students and export an updated list."
                                   style="-fx-font-size: 12; -fx-text-fill: #6c757d; -fx-wrap-text: true;"/>
                        </VBox>
                        <Button text="Open Tool" onAction="#handleUAListUpdater"
                                style="-fx-base: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;">
                            <tooltip>
                                <Tooltip text="Open UA List Updater tool"/>
                            </tooltip>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Invoice List Updater Tool Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="📝" style="-fx-font-size: 32;"/>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Invoice List Updater" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
                            <Label text="Manage and update invoice records efficiently. Track payment statuses, view billing trends, and maintain regional invoice data."
                                   style="-fx-font-size: 12; -fx-text-fill: #6c757d; -fx-wrap-text: true;"/>
                        </VBox>
                        <Button text="Open Tool" onAction="#handleInvoiceListUpdater"
                                style="-fx-base: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;">
                            <tooltip>
                                <Tooltip text="Open Invoice List Updater tool"/>
                            </tooltip>
                        </Button>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>

    </TabPane>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label fx:id="rowCountLabel" text="0 rows loaded"/>
        <Label fx:id="colCountLabel" text="0 columns selected"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Export to PowerPoint" onAction="#handleExport"/>
    </HBox>

</VBox>